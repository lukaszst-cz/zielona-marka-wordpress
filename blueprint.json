{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "preferredVersions": {
    "php": "8.3",
    "wp": "latest"
  },
  "landingPage": "/",
  "login": true,
  "siteOptions": {
    "blogname": "Zielona Marka — WordPress 1:1",
    "blogdescription": "Podgląd motywu WordPress"
  },
